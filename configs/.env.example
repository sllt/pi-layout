# Pi Framework Configuration
# This file is loaded by Pi automatically from ./configs/.env

# =============================================================================
# HTTP Server
# =============================================================================
HTTP_HOST=127.0.0.1
HTTP_PORT=8000
HTTP_ENABLED=true
# *_ADDR takes precedence over HOST/PORT. Use 127.0.0.1:0 for a random port.
# HTTP_ADDR=127.0.0.1:8000
GRPC_ENABLED=false
METRICS_HOST=127.0.0.1
METRICS_PORT=9122
METRICS_ENABLED=false
# Build uses explicit per-app exporters. Enable with WithMetrics/WithMetricsHandler.

# =============================================================================
# Database
# =============================================================================
# The bundled business migrations/repositories are verified with SQLite.
# Pi connectors support MySQL/PostgreSQL; adapt business SQL before switching.
DB_DIALECT=sqlite

# SQLite (just need DB_NAME as file path)
DB_NAME=storage/app.db

# MySQL example:
# DB_DIALECT=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=123456
# DB_NAME=user

# PostgreSQL example:
# DB_DIALECT=postgres
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=postgres
# DB_NAME=user
# DB_SSL_MODE=disable

# =============================================================================
# Logging
# =============================================================================
# Levels: DEBUG, INFO, NOTICE, WARN, ERROR, FATAL
LOG_LEVEL=DEBUG

# =============================================================================
# Validation
# =============================================================================
# Supported locales: zh, en
VALIDATION_LOCALE=zh

# =============================================================================
# Security
# =============================================================================
# JWT signing key.
# Put a real value in local configs/.env or runtime environment variables,
# and never commit real secrets into version control.
JWT_SECRET=replace-with-a-strong-random-secret
JWT_ISSUER=pi-layout
JWT_AUDIENCE=pi-api
JWT_TTL=1h

# No cross-origin access by default. Comma-separated exact origins, no paths.
CORS_ALLOWED_ORIGINS=
CORS_ALLOW_CREDENTIALS=false

# API signature verification (optional)
API_SIGN_KEY=123456
API_SIGN_SECRET=123456

# =============================================================================
# Redis (optional)
# =============================================================================
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_DB=0
